<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:App.Desktop.ViewModels"
        xmlns:core="using:App.Core.Models"
        xmlns:terminal="using:SvcSystems.UI.Terminal"
        xmlns:ctl="using:App.Desktop.Controls"
        x:Class="App.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="Keyce Code"
        Width="1360"
        Height="780"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgMain}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BgMain">#0E0A1F</SolidColorBrush>
                    <SolidColorBrush x:Key="BgBar">#14102B</SolidColorBrush>
                    <SolidColorBrush x:Key="BgSide">#171230</SolidColorBrush>
                    <SolidColorBrush x:Key="BgPanel">#12102A</SolidColorBrush>
                    <SolidColorBrush x:Key="BgHover">#1E1840</SolidColorBrush>
                    <SolidColorBrush x:Key="BgFloat">#1E1840</SolidColorBrush>
                    <SolidColorBrush x:Key="Line">#2A2350</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMain">#E9E5FF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMuted">#9B93C4</SolidColorBrush>
                    <SolidColorBrush x:Key="TextDim">#7F78A8</SolidColorBrush>
                    <SolidColorBrush x:Key="TextAccent">#C4B5FD</SolidColorBrush>
                    <SolidColorBrush x:Key="TextTitle">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="Icon">#9A8FC9</SolidColorBrush>
                    <SolidColorBrush x:Key="IconActive">#F3EFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="FolderIcon">#C084FC</SolidColorBrush>
                    <SolidColorBrush x:Key="Accent">#A855F7</SolidColorBrush>
                    <SolidColorBrush x:Key="Primary">#6D28D9</SolidColorBrush>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgMain">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="BgBar">#EEEAF8</SolidColorBrush>
                    <SolidColorBrush x:Key="BgSide">#F5F2FC</SolidColorBrush>
                    <SolidColorBrush x:Key="BgPanel">#F3F0FA</SolidColorBrush>
                    <SolidColorBrush x:Key="BgHover">#E6E0F5</SolidColorBrush>
                    <SolidColorBrush x:Key="BgFloat">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="Line">#D9D2EE</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMain">#1F1A3D</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMuted">#5E5683</SolidColorBrush>
                    <SolidColorBrush x:Key="TextDim">#7A7399</SolidColorBrush>
                    <SolidColorBrush x:Key="TextAccent">#6D28D9</SolidColorBrush>
                    <SolidColorBrush x:Key="TextTitle">#1F1A3D</SolidColorBrush>
                    <SolidColorBrush x:Key="Icon">#5B5185</SolidColorBrush>
                    <SolidColorBrush x:Key="IconActive">#1F1A3D</SolidColorBrush>
                    <SolidColorBrush x:Key="FolderIcon">#9333EA</SolidColorBrush>
                    <SolidColorBrush x:Key="Accent">#7C3AED</SolidColorBrush>
                    <SolidColorBrush x:Key="Primary">#7C3AED</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Gesture="Ctrl+J" Command="{Binding ToggleBottomCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+E"
                    Command="{Binding ShowPanelCommand}"
                    CommandParameter="0" />
        <KeyBinding Gesture="Ctrl+Shift+F"
                    Command="{Binding ShowPanelCommand}"
                    CommandParameter="1" />
        <KeyBinding Gesture="Ctrl+F5" Command="{Binding RunActiveFileCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding DebugActiveFileCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="Path.icon">
            <Setter Property="Stroke" Value="{DynamicResource Icon}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>

        <Style Selector="Path.active">
            <Setter Property="Stroke" Value="{DynamicResource IconActive}" />
        </Style>

        <Style Selector="Path.small">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>

        <Style Selector="Button.act">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.act:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>

        <Style Selector="Border.doctab">
            <Setter Property="Background" Value="{DynamicResource BgBar}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,2,0,0" />
        </Style>

        <Style Selector="Border.doctab.active">
            <Setter Property="Background" Value="{DynamicResource BgMain}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextAccent}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <!-- Boutons des panneaux : primary (action principale), secondary, danger, tool (icône), ghost (lien) -->
        <Style Selector="Button.primary, Button.secondary, Button.danger">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource Primary}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="6,7" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Line}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
        </Style>
        <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.tool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
        <Style Selector="Button.tool:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextAccent}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="Foreground" Value="{DynamicResource TextAccent}" />
        </Style>

        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextAccent}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource BgMain}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource BgMain}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- Menus -->
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource BgMain}"
              FontSize="13">

            <MenuItem Header="_Fichier">
                <MenuItem Header="Nouveau fichier"
                          InputGesture="Ctrl+N"
                          Command="{Binding NewFileCommand}" />
                <MenuItem Header="Nouveau dossier..."
                          Click="OnNewFolderHere" />
                <Separator />
                <MenuItem Header="Ouvrir un fichier..."
                          InputGesture="Ctrl+O"
                          Click="OnOpenFile" />
                <MenuItem Header="Ouvrir un dossier..."
                          Click="OnOpenFolder" />
                <Separator />
                <MenuItem Header="Enregistrer"
                          InputGesture="Ctrl+S"
                          Click="OnSave"
                          IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Enregistrer sous..."
                          InputGesture="Ctrl+Shift+S"
                          Click="OnSaveAs"
                          IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Fermer le fichier"
                          Click="OnCloseActive"
                          IsEnabled="{Binding HasFile}" />
                <Separator />
                <MenuItem Header="Quitter" Click="OnExit" />
            </MenuItem>

            <MenuItem Header="_Édition">
                <MenuItem Header="Annuler"
                          InputGesture="Ctrl+Z"
                          Command="{Binding UndoCommand}"
                          IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Rétablir"
                          InputGesture="Ctrl+Y"
                          Command="{Binding RedoCommand}"
                          IsEnabled="{Binding HasFile}" />
                <Separator />
                <MenuItem Header="Couper" Click="OnCut"
                          IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Copier" Click="OnCopy"
                          IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Coller" Click="OnPaste"
                          IsEnabled="{Binding HasFile}" />
                <Separator />
                <MenuItem Header="Rechercher dans le fichier"
                          InputGesture="Ctrl+F"
                          Click="OnFind"
                          IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Remplacer"
                          Click="OnFind"
                          IsEnabled="{Binding HasFile}" />
            </MenuItem>

            <MenuItem Header="_Sélection">
                <MenuItem Header="Tout sélectionner"
                          Command="{Binding SelectAllTextCommand}"
                          IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Ajouter un curseur"
                          Command="{Binding NotAvailableCommand}"
                          CommandParameter="développeur 2|Ajouter un curseur" />
            </MenuItem>

            <MenuItem Header="_Affichage">
                <MenuItem Header="Palette de commandes..." IsEnabled="False" />
                <MenuItem Header="Paramètres..." Click="OnOpenSettings" />
                <Separator />
                <MenuItem Header="Explorateur"
                          Command="{Binding ShowPanelCommand}"
                          CommandParameter="0" />
                <MenuItem Header="Recherche"
                          Command="{Binding ShowPanelCommand}"
                          CommandParameter="1" />
                <MenuItem Header="Contrôle de code source (panneau droit)"
                          Command="{Binding FocusRightGitCommand}" />
                <MenuItem Header="Assistant IA (panneau droit)"
                          Command="{Binding FocusRightAiCommand}" />
                <MenuItem Header="Exécuter et déboguer"
                          Command="{Binding ShowPanelCommand}"
                          CommandParameter="3" />
                <MenuItem Header="Extensions"
                          Command="{Binding ShowPanelCommand}"
                          CommandParameter="4" />
                <Separator />
                <MenuItem Header="Problèmes"
                          Command="{Binding ShowBottomCommand}"
                          CommandParameter="0" />
                <MenuItem Header="Sortie"
                          Command="{Binding ShowBottomCommand}"
                          CommandParameter="1" />
                <MenuItem Header="Terminal"
                          Command="{Binding ShowBottomCommand}"
                          CommandParameter="2" />
                <MenuItem Header="Afficher / masquer le panneau du bas"
                          InputGesture="Ctrl+J"
                          Command="{Binding ToggleBottomCommand}" />
                <Separator />
                <MenuItem Header="Afficher / masquer la barre latérale"
                          InputGesture="Ctrl+B"
                          Command="{Binding ToggleSidebarCommand}" />
                <MenuItem Header="Afficher / masquer le panneau droit (IA &amp; Git)"
                          Command="{Binding ToggleRightPanelCommand}" />
                <MenuItem Header="Thème clair / sombre"
                          Click="OnToggleTheme" />
            </MenuItem>

            <MenuItem Header="_Atteindre">
                <MenuItem Header="Aller au fichier..."
                          InputGesture="Ctrl+P"
                          Click="OnGoToFile" />
                <MenuItem Header="Aller à la ligne..."
                          InputGesture="Ctrl+G"
                          Click="OnGoToLine"
                          IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Aller à la définition"
                          Command="{Binding NotAvailableCommand}"
                          CommandParameter="développeur 3|Aller à la définition" />
            </MenuItem>

            <MenuItem Header="E_xécuter">
                <MenuItem Header="Démarrer le débogage"
                          Click="OnStartDebug" />
                <MenuItem Header="Exécuter sans débogage"
                          InputGesture="Ctrl+F5"
                          Command="{Binding RunActiveFileCommand}"
                          IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Arrêter l'exécution"
                          Command="{Binding StopExecutionCommand}"
                          IsEnabled="{Binding IsExecuting}" />
                <MenuItem Header="Arrêter"
                          Command="{Binding StopDebugCommand}" />
            </MenuItem>

            <MenuItem Header="_Terminal">
                <MenuItem Header="Nouveau terminal"
                          Command="{Binding ShowBottomCommand}"
                          CommandParameter="2" />
                <MenuItem Header="Exécuter une tâche..."
                          Click="OnShowTasks" />
                <MenuItem Header="Configurer les tâches..."
                          Click="OnConfigureTasks" />
            </MenuItem>

            <MenuItem Header="_Aide">
                <MenuItem Header="Documentation" Click="OnDocumentation" />
                <MenuItem Header="Raccourcis clavier" Click="OnShortcuts" />
                <Separator />
                <MenuItem Header="À propos de Keyce Code" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <!-- Barre d'état -->
        <Border DockPanel.Dock="Bottom"
                Height="24"
                Background="{DynamicResource Primary}">
            <Grid ColumnDefinitions="*,Auto" Margin="12,0">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="16"
                            VerticalAlignment="Center"
                            IsVisible="{Binding HasFile}">
                    <TextBlock Text="{Binding Position}" Foreground="White" FontSize="12" />
                    <TextBlock Text="{Binding Encoding}" Foreground="White" FontSize="12" />
                    <TextBlock Text="{Binding Language}" Foreground="White" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="RootGrid"
              ColumnDefinitions="52,240,4,*,4,350">

            <!-- Barre d'activité -->
            <Border Grid.Column="0" Background="{DynamicResource BgBar}">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Classes="act" Click="OnOpenSettings"
                            ToolTip.Tip="Paramètres">
                        <Path Classes="icon"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z M12 4.5a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15z M12 2v2.5 M12 19.5V22 M2 12h2.5 M19.5 12H22 M4.9 4.9l1.8 1.8 M17.3 17.3l1.8 1.8 M4.9 19.1l1.8-1.8 M17.3 6.7l1.8-1.8" />
                    </Button>

                    <StackPanel>
                        <Grid Height="48">
                            <Border Width="2"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Accent}"
                                    IsVisible="{Binding IsExplorerActive}" />
                            <Button Classes="act"
                                    Command="{Binding ShowPanelCommand}"
                                    CommandParameter="0">
                                <Path Classes="icon"
                                      Classes.active="{Binding IsExplorerActive}"
                                      Data="M5 7h9l4 4v10H5z M14 7v4h4 M8 7V3h8l4 4v10h-2" />
                            </Button>
                        </Grid>

                        <Grid Height="48">
                            <Border Width="2"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Accent}"
                                    IsVisible="{Binding IsSearchActive}" />
                            <Button Classes="act"
                                    Command="{Binding ShowPanelCommand}"
                                    CommandParameter="1">
                                <Path Classes="icon"
                                      Classes.active="{Binding IsSearchActive}"
                                      Data="M14 4a6 6 0 1 0 0 12 6 6 0 0 0 0-12z M9.8 14.2L4 20" />
                            </Button>
                        </Grid>

                        <Grid Height="48">
                            <Border Width="2"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Accent}"
                                    IsVisible="{Binding IsRightGitHighlighted}" />
                            <Button Classes="act"
                                    Command="{Binding FocusRightGitCommand}"
                                    ToolTip.Tip="Contrôle de code source (Git à droite)">
                                <Path Classes="icon"
                                      Classes.active="{Binding IsRightGitHighlighted}"
                                      Data="M6 2.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z M6 16.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z M18 6.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z M6 7.5v9 M18 11.5c0 3.5-12 1.5-12 5" />
                            </Button>
                        </Grid>

                        <Grid Height="48">
                            <Border Width="2"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Accent}"
                                    IsVisible="{Binding IsRunActive}" />
                            <Button Classes="act"
                                    Command="{Binding ShowPanelCommand}"
                                    CommandParameter="3">
                                <Path Classes="icon"
                                      Classes.active="{Binding IsRunActive}"
                                      Data="M5 3.5l10 6.5-10 6.5z M15.5 17.5a2.5 3.5 0 1 0 5 0 2.5 3.5 0 0 0-5 0z M14 16h1.5 M20.5 16H22 M14 20h1.5 M20.5 20H22 M18 14v7" />
                            </Button>
                        </Grid>

                        <Grid Height="48">
                            <Border Width="2"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Accent}"
                                    IsVisible="{Binding IsExtensionsActive}" />
                            <Button Classes="act"
                                    Command="{Binding ShowPanelCommand}"
                                    CommandParameter="4">
                                <Path Classes="icon"
                                      Classes.active="{Binding IsExtensionsActive}"
                                      Data="M3 13h7v7H3z M12 13h7v7h-7z M3 4h7v7H3z M15 2h6v6h-6z" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Barre latérale -->
            <Border Grid.Column="1"
                    Background="{DynamicResource BgSide}"
                    ClipToBounds="True"
                    IsVisible="{Binding IsSidebarVisible}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding PanelTitle}"
                               FontSize="11"
                               Foreground="{DynamicResource TextAccent}"
                               Margin="16,12,0,4" />

                    <Grid>

                        <!-- Explorateur -->
                        <DockPanel IsVisible="{Binding IsExplorerActive}">
                            <Grid DockPanel.Dock="Top"
                                  ColumnDefinitions="*,Auto,Auto,Auto"
                                  Margin="16,0,8,6"
                                  IsVisible="{Binding HasFolder}">
                                <TextBlock Text="{Binding FolderName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextMain}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Classes="tool"
                                        Click="OnNewFileHere"
                                        ToolTip.Tip="Nouveau fichier">
                                    <Path Classes="icon small"
                                          Data="M6 2h8l4 4v16H6z M14 2v4h4 M12 11v6 M9 14h6" />
                                </Button>
                                <Button Grid.Column="2"
                                        Classes="tool"
                                        Click="OnNewFolderHere"
                                        ToolTip.Tip="Nouveau dossier">
                                    <Path Classes="icon small"
                                          Data="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M12 11v6 M9 14h6" />
                                </Button>
                                <Button Grid.Column="3"
                                        Classes="tool"
                                        Click="OnRefreshExplorer"
                                        ToolTip.Tip="Actualiser">
                                    <Path Classes="icon small"
                                          Data="M20 11a8 8 0 1 0-2.3 5.7 M20 4v7h-7" />
                                </Button>
                            </Grid>

                            <Button DockPanel.Dock="Top"
                                    Content="Ouvrir un autre projet / dossier..."
                                    Classes="secondary"
                                    Margin="12,0,12,6"
                                    Padding="8,5"
                                    FontSize="11"
                                    Click="OnOpenFolder"
                                    IsVisible="{Binding HasFolder}" />

                            <StackPanel DockPanel.Dock="Top"
                                        Margin="16,16"
                                        Spacing="10"
                                        IsVisible="{Binding !HasFolder}">
                                <TextBlock Text="Aucun dossier ouvert"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="12" />
                                <Button Content="Ouvrir un dossier"
                                        Classes="primary"
                                        Click="OnOpenFolder" />
                                <Button Content="Ouvrir un fichier"
                                        Classes="secondary"
                                        Click="OnOpenFile" />
                                <Button Content="Nouveau dossier"
                                        Classes="secondary"
                                        Click="OnNewFolderHere" />
                            </StackPanel>

                            <TreeView ItemsSource="{Binding Nodes}"
                                      Background="Transparent"
                                      Margin="4,0"
                                      SelectionChanged="OnNodeSelected"
                                      IsVisible="{Binding HasFolder}">
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Nouveau fichier..."
                                                  Click="OnNewFileHere" />
                                        <MenuItem Header="Nouveau dossier..."
                                                  Click="OnNewFolderHere" />
                                        <Separator />
                                        <MenuItem Header="Actualiser"
                                                  Click="OnRefreshExplorer" />
                                        <MenuItem Header="Supprimer"
                                                  Click="OnDeleteSelected" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate DataType="vm:FileNode"
                                                      ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="icon small"
                                                  IsVisible="{Binding IsDirectory}"
                                                  Stroke="{DynamicResource FolderIcon}"
                                                  Data="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                            <Path Classes="icon small"
                                                  IsVisible="{Binding !IsDirectory}"
                                                  Data="M6 2h8l4 4v16H6z M14 2v4h4" />
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource TextMain}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>

                        <!-- Recherche de fichiers -->
                        <DockPanel IsVisible="{Binding IsSearchActive}">
                            <TextBox DockPanel.Dock="Top"
                                     x:Name="SearchBox"
                                     Text="{Binding SearchQuery}"
                                     PlaceholderText="Nom de fichier..."
                                     Margin="12,6"
                                     Background="{DynamicResource BgMain}"
                                     Foreground="{DynamicResource TextMain}" />

                            <TextBlock DockPanel.Dock="Top"
                                       Text="{Binding SearchInfo}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="12"
                                       Margin="16,0,0,6" />

                            <ListBox ItemsSource="{Binding SearchResults}"
                                     Background="Transparent"
                                     SelectionChanged="OnNodeSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:FileNode">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource TextMain}"
                                                       FontSize="13" />
                                            <TextBlock Text="{Binding Directory}"
                                                       Foreground="{DynamicResource TextDim}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- Git (affiché dans le panneau droit) -->
                        <Border Classes="card"
                                Margin="12,8"
                                Padding="12"
                                VerticalAlignment="Top"
                                IsVisible="{Binding IsGitActive}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Le contrôle de code source (Git &amp; GitHub) se trouve directement à droite de l'interface."
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMain}" />
                                <Button Content="Afficher Git &amp; GitHub à droite"
                                        Classes="primary"
                                        Command="{Binding FocusRightGitCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- Exécuter et déboguer -->
                        <ScrollViewer IsVisible="{Binding IsRunActive}">
                            <StackPanel Margin="12,2,12,12" Spacing="10">

                                <!-- Exécution simple, indépendante du débogueur -->
                                <TextBlock Classes="section"
                                           Text="EXÉCUTER UN PROGRAMME" />

                                <TextBox Text="{Binding ExecutionExecutable}"
                                         PlaceholderText="Programme : dotnet, python, node, monapp.exe…"
                                         Padding="8,7"
                                         IsEnabled="{Binding IsExecutionIdle}"
                                         Background="{DynamicResource BgMain}"
                                         Foreground="{DynamicResource TextMain}" />

                                <TextBox Text="{Binding ExecutionArguments}"
                                         PlaceholderText="Arguments : bin\Debug\net10.0\MonApp.dll --verbose"
                                         Padding="8,7"
                                         IsEnabled="{Binding IsExecutionIdle}"
                                         Background="{DynamicResource BgMain}"
                                         Foreground="{DynamicResource TextMain}" />

                                <TextBox Text="{Binding ExecutionWorkingDirectory}"
                                         PlaceholderText="Dossier de travail (facultatif)"
                                         Padding="8,7"
                                         IsEnabled="{Binding IsExecutionIdle}"
                                         Background="{DynamicResource BgMain}"
                                         Foreground="{DynamicResource TextMain}" />

                                <TextBlock Text="ENCODAGE DE LA SORTIE"
                                           Classes="section" />

                                <ComboBox SelectedIndex="{Binding ExecutionOutputEncodingIndex}"
                                          IsEnabled="{Binding IsExecutionIdle}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="UTF-8 (65001) — recommandé" />
                                    <ComboBoxItem Content="CP850 — commandes Windows classiques" />
                                </ComboBox>

                                <Grid ColumnDefinitions="*,6,*">
                                    <Button Grid.Column="0"
                                            Content="▶ Exécuter"
                                            Classes="primary"
                                            Command="{Binding StartExecutionCommand}"
                                            IsVisible="{Binding IsExecutionIdle}" />
                                    <Button Grid.Column="2"
                                            Content="■ Arrêter"
                                            Classes="danger"
                                            Command="{Binding StopExecutionCommand}"
                                            IsVisible="{Binding IsExecuting}" />
                                </Grid>

                                <Border Classes="card"
                                        BorderBrush="{DynamicResource Accent}"
                                        BorderThickness="3,0,0,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="section"
                                                   Text="ÉTAT DE L'EXÉCUTION" />
                                        <TextBlock Text="{Binding ExecutionStatus}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextMain}" />
                                    </StackPanel>
                                </Border>

                                <Border Height="1"
                                        Background="{DynamicResource Line}"
                                        Margin="0,4" />

                                <TextBlock Classes="section"
                                           Text="PROGRAMME À DÉBOGUER" />

                                <TextBox Text="{Binding DebugProgram}"
                                         PlaceholderText="MonApp.dll, script.py, main.go ou exécutable compilé"
                                         Padding="8,7"
                                         IsEnabled="{Binding IsDebugIdle}"
                                         Background="{DynamicResource BgMain}"
                                         Foreground="{DynamicResource TextMain}" />

                                <Button Content="Parcourir un programme..."
                                        Classes="secondary"
                                        Click="OnBrowseProgram"
                                        IsEnabled="{Binding IsDebugIdle}" />

                                <!-- Démarrer / arrêter -->
                                <Button Content="▶  Démarrer le débogage"
                                        Classes="primary"
                                        Command="{Binding StartDebugCommand}"
                                        IsVisible="{Binding IsDebugIdle}" />
                                <Button Content="■  Arrêter la session"
                                        Classes="danger"
                                        Command="{Binding StopDebugCommand}"
                                        IsVisible="{Binding IsDebugging}" />

                                <!-- Pas à pas -->
                                <Grid ColumnDefinitions="*,6,*"
                                      RowDefinitions="Auto,6,Auto">
                                    <Button Grid.Row="0" Grid.Column="0"
                                            Classes="secondary"
                                            Content="Continuer"
                                            Command="{Binding DebugContinueCommand}"
                                            IsEnabled="{Binding IsDebugging}" />
                                    <Button Grid.Row="0" Grid.Column="2"
                                            Classes="secondary"
                                            Content="Pas à pas"
                                            Command="{Binding DebugOverCommand}"
                                            IsEnabled="{Binding IsDebugging}" />
                                    <Button Grid.Row="2" Grid.Column="0"
                                            Classes="secondary"
                                            Content="Entrer"
                                            Command="{Binding DebugIntoCommand}"
                                            IsEnabled="{Binding IsDebugging}" />
                                    <Button Grid.Row="2" Grid.Column="2"
                                            Classes="secondary"
                                            Content="Sortir"
                                            Command="{Binding DebugOutCommand}"
                                            IsEnabled="{Binding IsDebugging}" />
                                </Grid>

                                <!-- État de la session -->
                                <Border Classes="card"
                                        BorderBrush="{DynamicResource Accent}"
                                        BorderThickness="3,0,0,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="section"
                                                   Text="ÉTAT" />
                                        <TextBlock Text="{Binding DebugStatus}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextMain}" />
                                    </StackPanel>
                                </Border>

                                <!-- Points d'arrêt -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="section"
                                                   Text="POINTS D'ARRÊT" />
                                        <Border Background="{DynamicResource BgHover}"
                                                CornerRadius="9"
                                                Padding="7,1">
                                            <TextBlock Text="{Binding Breakpoints.Count}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMain}" />
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="ghost"
                                            Content="Tout supprimer"
                                            Command="{Binding ClearBreakpointsCommand}" />
                                </Grid>

                                <Button Content="● Ajouter à la ligne du curseur"
                                        Classes="secondary"
                                        Click="OnAddBreakpoint" />

                                <ItemsControl ItemsSource="{Binding Breakpoints}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8"
                                                        Margin="2,3">
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         Fill="#EF4444"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextMain}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Classes="card"
                                        IsVisible="{Binding IsDebugIdle}">
                                    <TextBlock TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextDim}"
                                               Text="F5 compile puis débogue le fichier actif : C# (NetCoreDbg), Python (debugpy), Go (Delve), C / C++ / Rust (lldb-dap). L'adaptateur du langage doit être installé et dans le PATH." />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Extensions & Assistant IA -->
                        <DockPanel IsVisible="{Binding IsExtensionsActive}">
                            <StackPanel DockPanel.Dock="Top"
                                        Margin="12,4,12,8"
                                        Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding CatalogSearchQuery}"
                                             PlaceholderText="Rechercher sur Open VSX (python, c#, git...)"
                                             Background="{DynamicResource BgMain}"
                                             Foreground="{DynamicResource TextMain}" />
                                    <Button Grid.Column="1"
                                            Classes="primary"
                                            Content="Chercher"
                                            Command="{Binding SearchCatalogCommand}"
                                            Margin="6,0,0,0"
                                            Padding="10,6" />
                                </Grid>

                                <Border Classes="card"
                                        IsVisible="{Binding IsCatalogInstalling}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding CatalogProgressText}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMain}" />
                                        <ProgressBar Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding CatalogInstallProgress}"
                                                     Height="6"
                                                     Foreground="{DynamicResource Accent}"
                                                     Background="{DynamicResource BgMain}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding ExtensionsInfo}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMuted}" />
                            </StackPanel>

                            <ScrollViewer>
                                <StackPanel Margin="12,0,12,12" Spacing="10">
                                    <TextBlock Classes="section"
                                               Text="EXTENSIONS INSTALLÉES" />

                                    <ItemsControl ItemsSource="{Binding ExtensionItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ExtensionItem">
                                                <Border Classes="card"
                                                        Margin="0,0,0,8">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource TextMain}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding StateText}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextAccent}" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextMuted}" />
                                                        <TextBlock Text="{Binding PackageDetails}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="#4ADE80" />
                                                        <TextBlock Text="{Binding Permissions}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextDim}" />
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="6"
                                                                    Margin="0,4,0,0">
                                                            <Button Content="{Binding ToggleLabel}"
                                                                    Click="OnExtensionToggle"
                                                                    Padding="10,4" />
                                                            <Button Content="Désinstaller"
                                                                    Click="OnExtensionUninstall"
                                                                    Padding="10,4" />
                                                        </StackPanel>
                                                        <Button Content="Ouvrir README / package.json"
                                                                Classes="secondary"
                                                                Click="OnExtensionOpenReadme"
                                                                IsVisible="{Binding HasReadme}"
                                                                Padding="8,4" />
                                                        <Button Content="{Binding UpdateLabel}"
                                                                Classes="primary"
                                                                Click="OnExtensionUpdateFromCatalog"
                                                                IsVisible="{Binding HasUpdate}"
                                                                Padding="10,4" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="Installer depuis un dossier local..."
                                            Classes="secondary"
                                            Click="OnInstallExtension" />
                                    <Button Content="Mettre à jour depuis un dossier..."
                                            Classes="secondary"
                                            Click="OnUpdateExtension" />

                                    <TextBlock Classes="section"
                                               Text="COMMANDES D'EXTENSIONS"
                                               Margin="0,4,0,0" />

                                    <ItemsControl ItemsSource="{Binding ExtensionCommands}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="core:CommandInfo">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Title}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextMain}"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="1"
                                                            Classes="ghost"
                                                            Content="Exécuter"
                                                            Click="OnExecuteExtensionCommand" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Classes="section"
                                               Text="MARKETPLACE (EN LIGNE)"
                                               Margin="0,8,0,0" />

                                    <ItemsControl ItemsSource="{Binding CatalogItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:CatalogExtensionItem">
                                                <Border Classes="card"
                                                        Margin="0,0,0,8">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource TextMain}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextAccent}" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextMuted}" />
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="6"
                                                                    Margin="0,4,0,0">
                                                            <Button Content="Télécharger &amp; Installer"
                                                                    Classes="primary"
                                                                    Click="OnCatalogInstallClick"
                                                                    IsVisible="{Binding CanInstall}"
                                                                    Padding="10,4" />
                                                            <Button Content="Mettre à jour"
                                                                    Classes="primary"
                                                                    Click="OnCatalogUpdateClick"
                                                                    IsVisible="{Binding CanUpdate}"
                                                                    Padding="10,4" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Panneaux non encore disponibles -->
                        <StackPanel IsVisible="{Binding IsPlaceholderActive}"
                                    Margin="16,12">
                            <TextBlock Text="{Binding PlaceholderMessage}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="2"
                          Background="{DynamicResource BgMain}"
                          ResizeDirection="Columns"
                          IsVisible="{Binding IsSidebarVisible}" />

            <!-- Zone centrale -->
            <Grid Grid.Column="3"
                  x:Name="CenterGrid"
                  RowDefinitions="36,*,0,0">

                <!-- Onglets des documents + accès direct Assistant IA / Git -->
                <Border Grid.Row="0" Background="{DynamicResource BgBar}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Border Background="{DynamicResource BgMain}"
                                    BorderBrush="{DynamicResource Accent}"
                                    BorderThickness="0,2,0,0"
                                    Padding="16,0"
                                    IsVisible="{Binding !HasFile}">
                                <TextBlock Text="Bienvenue"
                                           Foreground="{DynamicResource TextMain}"
                                           VerticalAlignment="Center"
                                           FontSize="13" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding Tabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:DocumentTab">
                                        <Border Classes="doctab"
                                                Classes.active="{Binding IsActive}"
                                                Padding="14,0,4,0"
                                                Cursor="Hand"
                                                PointerPressed="OnTabPressed">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{DynamicResource TextMain}"
                                                           VerticalAlignment="Center"
                                                           FontSize="13" />
                                                <TextBlock Text="●"
                                                           Foreground="{DynamicResource Accent}"
                                                           FontSize="9"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding IsDirty}" />
                                                <Button Content="✕"
                                                        Click="OnTabCloseClick"
                                                        Background="Transparent"
                                                        Foreground="{DynamicResource TextAccent}"
                                                        Padding="6,2" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Margin="6,0,8,0"
                                    VerticalAlignment="Center">
                            <Button Classes="ghost"
                                    Content="▶"
                                    Foreground="#3FB950"
                                    FontSize="15"
                                    Command="{Binding RunActiveFileCommand}"
                                    IsVisible="{Binding IsExecutionIdle}"
                                    IsEnabled="{Binding HasFile}"
                                    ToolTip.Tip="Exécuter le fichier actif (Ctrl+F5)" />
                            <Button Classes="ghost"
                                    Content="■"
                                    Foreground="#F85149"
                                    FontSize="15"
                                    Command="{Binding StopExecutionCommand}"
                                    IsVisible="{Binding IsExecuting}"
                                    ToolTip.Tip="Arrêter l'exécution" />
                            <Button Classes="ghost"
                                    Content="Déboguer"
                                    Command="{Binding DebugActiveFileCommand}"
                                    IsEnabled="{Binding HasFile}"
                                    ToolTip.Tip="Compiler et déboguer le fichier actif (F5)" />
                            <Button Classes="ghost"
                                    Content="Assistant IA"
                                    Command="{Binding FocusRightAiCommand}"
                                    ToolTip.Tip="Afficher / masquer l'Assistant IA à droite" />
                            <Button Classes="ghost"
                                    Content="Git &amp; GitHub"
                                    Command="{Binding FocusRightGitCommand}"
                                    ToolTip.Tip="Afficher / masquer Git &amp; GitHub à droite" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Accueil -->
                <Border Grid.Row="1"
                        Background="{DynamicResource BgMain}"
                        IsVisible="{Binding !HasFile}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="10">
                        <Image Source="avares://App.Desktop/Assets/logo.png"
                               Width="150"
                               Height="150" />

                        <TextBlock FontSize="46"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center">
                            <Run Text="Keyce "
                                 Foreground="{DynamicResource TextTitle}" />
                            <Run Text="Code" Foreground="#C026D3" />
                        </TextBlock>

                        <TextBlock Text="Créez. Codez. Innovez."
                                   FontSize="18"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextAccent}"
                                   HorizontalAlignment="Center" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="10"
                                    Margin="0,20,0,0">
                            <Button Content="Ouvrir un dossier..."
                                    Click="OnOpenFolder"
                                    Padding="20,8"
                                    Background="{DynamicResource Primary}"
                                    Foreground="White" />
                            <Button Content="Ouvrir un fichier..."
                                    Click="OnOpenFile"
                                    Padding="20,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Éditeur -->
                <ctl:CodeEditorControl Grid.Row="1"
                                       x:Name="CodeEditor"
                                       IsVisible="{Binding HasFile}" />

                <!-- Recherche et remplacement -->
                <Border Grid.Row="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,24,0"
                        Padding="8"
                        Background="{DynamicResource BgFloat}"
                        BorderBrush="{DynamicResource Line}"
                        BorderThickness="1"
                        CornerRadius="6"
                        IsVisible="{Binding IsFindVisible}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox x:Name="FindBox"
                                     Width="200"
                                     PlaceholderText="Rechercher..."
                                     Text="{Binding FindText}"
                                     Background="{DynamicResource BgMain}"
                                     Foreground="{DynamicResource TextMain}"
                                     KeyDown="OnFindKeyDown" />

                            <ToggleButton Content="Aa"
                                          IsChecked="{Binding MatchCase}"
                                          ToolTip.Tip="Respecter la casse" />

                            <ToggleButton Content=".*"
                                          IsChecked="{Binding UseRegex}"
                                          ToolTip.Tip="Expression régulière" />

                            <TextBlock Text="{Binding FindInfo}"
                                       Foreground="{DynamicResource TextAccent}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       MinWidth="80" />

                            <Button Content="↑"
                                    Click="OnFindPrevClick"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextAccent}" />

                            <Button Content="↓"
                                    Click="OnFindNextClick"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextAccent}" />

                            <Button Content="✕"
                                    Click="OnFindClose"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextAccent}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox Width="200"
                                     PlaceholderText="Remplacer par..."
                                     Text="{Binding ReplaceText}"
                                     Background="{DynamicResource BgMain}"
                                     Foreground="{DynamicResource TextMain}"
                                     KeyDown="OnReplaceKeyDown" />

                            <Button Content="Remplacer"
                                    Click="OnReplaceClick"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextAccent}" />

                            <Button Content="Tout remplacer"
                                    Click="OnReplaceAllClick"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextAccent}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <GridSplitter Grid.Row="2"
                              ResizeDirection="Rows"
                              Background="{DynamicResource BgMain}"
                              HorizontalAlignment="Stretch"
                              IsVisible="{Binding IsBottomVisible}" />

                <!-- Panneau inférieur -->
                <Border Grid.Row="3"
                        Background="{DynamicResource BgPanel}"
                        BorderBrush="{DynamicResource Line}"
                        BorderThickness="0,1,0,0"
                        IsVisible="{Binding IsBottomVisible}">
                    <DockPanel>

                        <Grid DockPanel.Dock="Top"
                              Height="32"
                              ColumnDefinitions="Auto,Auto,Auto,*,Auto">

                            <Grid Grid.Column="0">
                                <Border Height="2"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource Accent}"
                                        IsVisible="{Binding IsProblemsTab}" />
                                <Button Classes="tab"
                                        Content="PROBLÈMES"
                                        Command="{Binding SetBottomTabCommand}"
                                        CommandParameter="0" />
                            </Grid>

                            <Grid Grid.Column="1">
                                <Border Height="2"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource Accent}"
                                        IsVisible="{Binding IsOutputTab}" />
                                <Button Classes="tab"
                                        Content="SORTIE"
                                        Command="{Binding SetBottomTabCommand}"
                                        CommandParameter="1" />
                            </Grid>

                            <Grid Grid.Column="2">
                                <Border Height="2"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource Accent}"
                                        IsVisible="{Binding IsTerminalTab}" />
                                <Button Classes="tab"
                                        Content="TERMINAL"
                                        Command="{Binding SetBottomTabCommand}"
                                        CommandParameter="2" />
                            </Grid>

                            <Button Grid.Column="4"
                                    Content="✕"
                                    Command="{Binding ToggleBottomCommand}"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextAccent}"
                                    Margin="0,0,8,0" />
                        </Grid>

                        <Grid>

                            <!-- Problèmes -->
                            <DockPanel IsVisible="{Binding IsProblemsTab}">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="{Binding ProblemsSummary}"
                                           Margin="16,8,16,4"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="12" />

                                <ListBox ItemsSource="{Binding Problems}"
                                         Background="Transparent"
                                         SelectionChanged="OnProblemSelected">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="vm:ProblemItem">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Severity}"
                                                           FontSize="11"
                                                           Width="90"
                                                           Foreground="{DynamicResource TextAccent}" />
                                                <TextBlock Text="{Binding Message}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextMain}" />
                                                <TextBlock Text="{Binding Location}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextDim}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- Sortie -->
                            <DockPanel IsVisible="{Binding IsOutputTab}">
                                <!-- Saisie pour le programme en cours (entrée standard) -->
                                <Grid DockPanel.Dock="Bottom"
                                      ColumnDefinitions="*,Auto"
                                      Margin="8,4"
                                      IsVisible="{Binding IsExecuting}">
                                    <TextBox Grid.Column="0"
                                             x:Name="ExecutionInputBox"
                                             Text="{Binding ExecutionInput}"
                                             PlaceholderText="Saisie du programme — Entrée pour envoyer"
                                             FontFamily="Consolas,Cascadia Mono,monospace"
                                             FontSize="12">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter"
                                                        Command="{Binding SendExecutionInputCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                    <Button Grid.Column="1"
                                            Content="Envoyer"
                                            Margin="6,0,0,0"
                                            Command="{Binding SendExecutionInputCommand}" />
                                </Grid>

                                <TextBox Text="{Binding OutputText}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         Background="{DynamicResource BgPanel}"
                                         Foreground="{DynamicResource TextMain}"
                                         BorderThickness="0"
                                         FontFamily="Consolas,Cascadia Mono,monospace"
                                         FontSize="12"
                                         Padding="12,8" />
                            </DockPanel>

                            <!-- Terminal PTY avec émulateur XTerm -->
                            <Grid IsVisible="{Binding IsTerminalTab}"
                                  RowDefinitions="Auto,*"
                                  Margin="12"
                                  RowSpacing="8">

                                <Grid Grid.Row="0"
                                      ColumnDefinitions="Auto,Auto,*,Auto">

                                    <Button Grid.Column="0"
                                            Content="Démarrer"
                                            Command="{Binding StartTerminalCommand}"
                                            IsEnabled="{Binding !IsTerminalRunning}"
                                            Background="{DynamicResource Primary}"
                                            Foreground="White"
                                            Padding="12,6"
                                            Margin="0,0,8,0" />

                                    <Button Grid.Column="1"
                                            Content="Arrêter"
                                            Command="{Binding StopTerminalCommand}"
                                            IsEnabled="{Binding IsTerminalRunning}"
                                            Background="{DynamicResource BgHover}"
                                            Foreground="{DynamicResource TextMain}"
                                            Padding="12,6" />

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding TerminalStatus}"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <terminal:TerminalControl x:Name="TerminalView"
                                                          Grid.Row="1" />
                            </Grid>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="4"
                          Background="{DynamicResource BgMain}"
                          ResizeDirection="Columns"
                          IsVisible="{Binding IsRightPanelVisible}" />

            <!-- Panneau droit : Assistant IA & Contrôle de code source (Git & GitHub) directement visibles -->
            <Border Grid.Column="5"
                    Background="{DynamicResource BgSide}"
                    BorderBrush="{DynamicResource Line}"
                    BorderThickness="1,0,0,0"
                    ClipToBounds="True"
                    IsVisible="{Binding IsRightPanelVisible}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource BgBar}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="0,0,0,1"
                            Height="34">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <Grid Grid.Column="0">
                                <Border Height="2"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource Accent}"
                                        IsVisible="{Binding IsRightAiOnlyMode}" />
                                <Button Classes="tab"
                                        Content="ASSISTANT IA"
                                        Command="{Binding SetRightPanelTabCommand}"
                                        CommandParameter="1" />
                            </Grid>
                            <Grid Grid.Column="1">
                                <Border Height="2"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource Accent}"
                                        IsVisible="{Binding IsRightGitOnlyMode}" />
                                <Button Classes="tab"
                                        Content="GIT &amp; GITHUB"
                                        Command="{Binding SetRightPanelTabCommand}"
                                        CommandParameter="2" />
                            </Grid>
                            <Button Grid.Column="3"
                                    Content="✕"
                                    Command="{Binding ToggleRightPanelCommand}"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextAccent}"
                                    Padding="10,4"
                                    ToolTip.Tip="Masquer le panneau droit" />
                        </Grid>
                    </Border>

                    <Grid x:Name="RightContentGrid">

                        <!-- Section 1 : Assistant IA directement visible sur l'interface -->
                        <DockPanel IsVisible="{Binding IsRightAiVisible}">
                            <TextBlock DockPanel.Dock="Top"
                                       Classes="section"
                                       Text="ASSISTANT IA (CHAT &amp; CODE)"
                                       Margin="12,8,12,6" />

                            <ScrollViewer>
                                <StackPanel Margin="12,0,12,10" Spacing="8">
                                    <TextBox Text="{Binding AiPromptText}"
                                             PlaceholderText="Posez une question ou décrivez le code à créer / modifier..."
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Height="66"
                                             Background="{DynamicResource BgMain}"
                                             Foreground="{DynamicResource TextMain}" />

                                    <Button Content="Poser une question / Discuter (IA)"
                                            Classes="primary"
                                            Command="{Binding SendAiPromptCommand}" />

                                    <Button Content="Coder / Modifier dans l'éditeur (IA)"
                                            Classes="secondary"
                                            Command="{Binding AiWriteOrModifyCodeCommand}" />

                                    <Grid ColumnDefinitions="*,6,*">
                                        <Button Grid.Column="0"
                                                Content="Expliquer le code"
                                                Classes="secondary"
                                                Command="{Binding ExplainActiveCodeWithAiCommand}" />
                                        <Button Grid.Column="2"
                                                Content="Améliorer le code"
                                                Classes="secondary"
                                                Command="{Binding SuggestImprovementsWithAiCommand}" />
                                    </Grid>

                                    <Button Content="Insérer la réponse IA dans l'éditeur"
                                            Classes="secondary"
                                            Command="{Binding ApplyAiResponseToEditorCommand}" />

                                    <Border Classes="card">
                                        <TextBlock Text="{Binding AiResponseText}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextMain}" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Section 2 : Contrôle de code source (Git & GitHub) à droite de l'interface -->
                        <DockPanel IsVisible="{Binding IsRightGitVisible}">
                            <TextBlock DockPanel.Dock="Top"
                                       Classes="section"
                                       Text="CONTRÔLE DE CODE SOURCE (GIT &amp; GITHUB)"
                                       Margin="12,8,12,6" />

                            <StackPanel DockPanel.Dock="Top"
                                        Margin="12,0,12,6"
                                        Spacing="6">
                                <Grid ColumnDefinitions="*,6,*">
                                    <Button Grid.Column="0"
                                            Content="Ouvrir un autre projet..."
                                            Classes="secondary"
                                            FontSize="11"
                                            Padding="6,5"
                                            Click="OnOpenFolder" />
                                    <Button Grid.Column="2"
                                            Content="Mes projets sur ce PC"
                                            Classes="secondary"
                                            FontSize="11"
                                            Padding="6,5"
                                            Command="{Binding ToggleProjectsListCommand}" />
                                </Grid>

                                <Border Classes="card"
                                        Padding="8"
                                        MaxHeight="180"
                                        IsVisible="{Binding IsProjectsListVisible}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top"
                                                   Text="{Binding ProjectsSummary}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextAccent}"
                                                   Margin="0,0,0,4" />
                                        <ScrollViewer>
                                            <ItemsControl ItemsSource="{Binding LocalProjects}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:LocalProjectItem">
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource TextMain}" />
                                                                <TextBlock Text="{Binding Category}"
                                                                           FontSize="10"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource TextDim}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    Classes="ghost"
                                                                    Content="Ouvrir"
                                                                    Click="OnOpenLocalProjectClick" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <Grid>
                                <Border Classes="card"
                                        Margin="12,4,12,8"
                                        Padding="12"
                                        VerticalAlignment="Top"
                                        IsVisible="{Binding !HasFolder}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Ouvrez un dossier ou le dépôt du projet pour gérer branches, commits, diff, fusion et GitHub."
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextMain}" />
                                        <Button Content="Ouvrir le dépôt du projet"
                                                Classes="primary"
                                                Command="{Binding OpenDetectedGitRepoCommand}"
                                                IsVisible="{Binding HasDetectedGitRepo}" />
                                        <Button Content="Ouvrir un dossier..."
                                                Classes="secondary"
                                                Click="OnOpenFolder" />
                                    </StackPanel>
                                </Border>

                                <DockPanel IsVisible="{Binding HasFolder}">
                                    <!-- Branche courante + Diff + Actualiser -->
                                    <Grid DockPanel.Dock="Top"
                                          ColumnDefinitions="*,Auto,Auto"
                                          Margin="12,0,12,6">
                                        <Border Classes="card"
                                                Padding="10,6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Path Classes="icon small"
                                                      Stroke="{DynamicResource TextAccent}"
                                                      Data="M6 2.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z M6 16.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z M18 6.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z M6 7.5v9 M18 11.5c0 3.5-12 1.5-12 5" />
                                                <TextBlock Text="{Binding Git.Controller.CurrentBranch}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextAccent}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Button Grid.Column="1"
                                                Classes="ghost"
                                                Content="Diff"
                                                Margin="6,0,0,0"
                                                Command="{Binding ViewFullDiffCommand}"
                                                ToolTip.Tip="Afficher le diff complet dans Sortie" />
                                        <Button Grid.Column="2"
                                                Classes="tool"
                                                Margin="4,0,0,0"
                                                Command="{Binding Git.RefreshCommand}"
                                                ToolTip.Tip="Actualiser">
                                            <Path Classes="icon small"
                                                  Data="M20 11a8 8 0 1 0-2.3 5.7 M20 4v7h-7" />
                                        </Button>
                                    </Grid>

                                    <ScrollViewer>
                                        <StackPanel Margin="12,0,12,12" Spacing="8">

                                            <!-- Dossier qui n'est pas un dépôt -->
                                            <Border Classes="card"
                                                    Padding="12"
                                                    IsVisible="{Binding IsGitRepoMissing}">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="{Binding GitMessage}"
                                                               TextWrapping="Wrap"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextMain}" />
                                                    <Button Content="Initialiser un dépôt Git"
                                                            Classes="primary"
                                                            Command="{Binding InitGitCommand}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Erreur Git (pas « pas un dépôt ») -->
                                            <Border Classes="card"
                                                    BorderBrush="#F87171"
                                                    IsVisible="{Binding HasGitError}">
                                                <TextBlock Text="{Binding GitMessage}"
                                                           Foreground="#F87171"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </Border>

                                            <StackPanel Spacing="8"
                                                        IsVisible="{Binding !IsGitRepoMissing}">

                                                <TextBox Text="{Binding Git.Controller.CommitMessage}"
                                                         PlaceholderText="Message de commit"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Height="54"
                                                         Padding="8,6"
                                                         Background="{DynamicResource BgMain}"
                                                         Foreground="{DynamicResource TextMain}" />

                                                <Button Content="✓  Valider (commit)"
                                                        Classes="primary"
                                                        Command="{Binding Git.CommitCommand}"
                                                        IsEnabled="{Binding Git.Controller.CommitMessage,
                                                                    Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                                <Grid ColumnDefinitions="*,6,*" RowDefinitions="Auto,6,Auto">
                                                    <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                                            Classes="secondary"
                                                            Content="Tout indexer"
                                                            Command="{Binding Git.StageAllCommand}" />
                                                    <Button Grid.Row="2" Grid.Column="0"
                                                            Classes="secondary"
                                                            Content="↓  Pull"
                                                            Command="{Binding Git.PullCommand}" />
                                                    <Button Grid.Row="2" Grid.Column="2"
                                                            Classes="secondary"
                                                            Content="↑  Push"
                                                            Command="{Binding Git.PushCommand}" />
                                                </Grid>

                                                <Border Classes="card"
                                                        BorderBrush="#F87171"
                                                        Margin="0,2,0,2"
                                                        IsVisible="{Binding Git.Controller.HasConflicts}">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="Conflits de fusion détectés"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#F87171" />
                                                        <Button Content="Annuler la fusion (Abort)"
                                                                Classes="danger"
                                                                Command="{Binding Git.AbortMergeCommand}" />
                                                    </StackPanel>
                                                </Border>

                                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                                    <TextBlock Classes="section"
                                                               Text="BRANCHES &amp; FUSION" />
                                                    <Button Grid.Column="1"
                                                            Classes="ghost"
                                                            Content="Abort Merge"
                                                            Command="{Binding Git.AbortMergeCommand}" />
                                                </Grid>

                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Git.Controller.NewBranchName}"
                                                             PlaceholderText="Nouvelle branche..."
                                                             Background="{DynamicResource BgMain}"
                                                             Foreground="{DynamicResource TextMain}" />
                                                    <Button Grid.Column="1"
                                                            Classes="secondary"
                                                            HorizontalAlignment="Center"
                                                            Content="Créer"
                                                            Command="{Binding Git.CreateBranchCommand}"
                                                            Margin="6,0,0,0"
                                                            Padding="10,6" />
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Git.Controller.Branches}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="core:GitBranch">
                                                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Name}"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource TextMain}"
                                                                           VerticalAlignment="Center" />
                                                                <Button Grid.Column="1"
                                                                        Classes="ghost"
                                                                        Content="Basculer"
                                                                        Click="OnGitCheckoutBranchClick"
                                                                        IsEnabled="{Binding !IsCurrent}" />
                                                                <Button Grid.Column="2"
                                                                        Classes="ghost"
                                                                        Content="Fusionner"
                                                                        Click="OnGitMergeBranchClick"
                                                                        IsEnabled="{Binding !IsCurrent}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                                    <TextBlock Classes="section"
                                                               Text="CHANGEMENTS INDEXÉS" />
                                                    <Border Grid.Column="1"
                                                            Background="{DynamicResource Primary}"
                                                            CornerRadius="9"
                                                            Padding="7,1">
                                                        <TextBlock Text="{Binding StagedCount}"
                                                                   FontSize="10"
                                                                   Foreground="White" />
                                                    </Border>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Git.Controller.StagedFiles}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="core:GitFileStatus">
                                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                                  Margin="0,2">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding State}"
                                                                           FontSize="10"
                                                                           Width="70"
                                                                           Foreground="{DynamicResource TextDim}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Path}"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource TextMain}"
                                                                           VerticalAlignment="Center"
                                                                           Cursor="Hand"
                                                                           PointerPressed="OnGitFilePressed" />
                                                                <Button Grid.Column="2"
                                                                        Classes="ghost"
                                                                        Content="Retirer"
                                                                        Click="OnGitUnstageClick" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                                    <TextBlock Classes="section"
                                                               Text="CHANGEMENTS" />
                                                    <Border Grid.Column="1"
                                                            Background="{DynamicResource BgHover}"
                                                            CornerRadius="9"
                                                            Padding="7,1">
                                                        <TextBlock Text="{Binding UnstagedCount}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextMain}" />
                                                    </Border>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Git.Controller.UnstagedFiles}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="core:GitFileStatus">
                                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                                  Margin="0,2">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding State}"
                                                                           FontSize="10"
                                                                           Width="70"
                                                                           Foreground="{DynamicResource TextDim}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Path}"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource TextMain}"
                                                                           VerticalAlignment="Center"
                                                                           Cursor="Hand"
                                                                           PointerPressed="OnGitFilePressed" />
                                                                <Button Grid.Column="2"
                                                                        Classes="ghost"
                                                                        Content="Indexer"
                                                                        Click="OnGitStageClick" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Classes="section"
                                                           Text="HISTORIQUE DES COMMITS"
                                                           Margin="0,6,0,0" />

                                                <ItemsControl ItemsSource="{Binding Git.Controller.RecentCommits}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="core:GitCommitInfo">
                                                            <StackPanel Margin="0,2">
                                                                <TextBlock Text="{Binding Message}"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource TextMain}" />
                                                                <TextBlock Text="{Binding Author}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource TextDim}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Classes="section"
                                                           Text="GITHUB PULL REQUESTS"
                                                           Margin="0,6,0,0" />

                                                <Grid ColumnDefinitions="*,6,*">
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding GitHubOwner}"
                                                             PlaceholderText="Owner"
                                                             Background="{DynamicResource BgMain}"
                                                             Foreground="{DynamicResource TextMain}" />
                                                    <TextBox Grid.Column="2"
                                                             Text="{Binding GitHubRepo}"
                                                             PlaceholderText="Dépôt"
                                                             Background="{DynamicResource BgMain}"
                                                             Foreground="{DynamicResource TextMain}" />
                                                </Grid>

                                                <Button Content="Charger les PRs GitHub"
                                                        Classes="secondary"
                                                        Command="{Binding LoadGitHubPullRequestsCommand}" />

                                                <TextBlock Text="{Binding GitHubStatus}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextMuted}" />

                                                <ItemsControl ItemsSource="{Binding PullRequests}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="core:GitHubPullRequest">
                                                            <Border Classes="card" Margin="0,0,0,6">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="{DynamicResource TextMain}" />
                                                                    <TextBlock FontSize="11"
                                                                               Foreground="{DynamicResource TextAccent}">
                                                                        <Run Text="#" />
                                                                        <Run Text="{Binding Number}" />
                                                                        <Run Text=" • " />
                                                                        <Run Text="{Binding HeadBranch}" />
                                                                        <Run Text=" → " />
                                                                        <Run Text="{Binding BaseBranch}" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBox Text="{Binding NewPrTitle}"
                                                         PlaceholderText="Titre d'une nouvelle PR..."
                                                         Background="{DynamicResource BgMain}"
                                                         Foreground="{DynamicResource TextMain}" />
                                                <Grid ColumnDefinitions="*,6,Auto">
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding NewPrBase}"
                                                             PlaceholderText="Base (main)"
                                                             Background="{DynamicResource BgMain}"
                                                             Foreground="{DynamicResource TextMain}" />
                                                    <Button Grid.Column="2"
                                                            Classes="primary"
                                                            HorizontalAlignment="Center"
                                                            Content="Créer PR"
                                                            Command="{Binding CreateGitHubPullRequestCommand}"
                                                            Padding="12,6" />
                                                </Grid>

                                            </StackPanel>

                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>
                        </DockPanel>

                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
