<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:App.Desktop.ViewModels"
        xmlns:core="using:App.Core.Models"
        xmlns:terminal="using:SvcSystems.UI.Terminal"
        x:Class="App.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="Keyce Code"
        Width="1280"
        Height="780"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgMain}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BgMain">#0E0A1F</SolidColorBrush>
                    <SolidColorBrush x:Key="BgBar">#14102B</SolidColorBrush>
                    <SolidColorBrush x:Key="BgSide">#171230</SolidColorBrush>
                    <SolidColorBrush x:Key="BgPanel">#12102A</SolidColorBrush>
                    <SolidColorBrush x:Key="BgHover">#1E1840</SolidColorBrush>
                    <SolidColorBrush x:Key="BgFloat">#1E1840</SolidColorBrush>
                    <SolidColorBrush x:Key="Line">#2A2350</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMain">#E9E5FF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMuted">#9B93C4</SolidColorBrush>
                    <SolidColorBrush x:Key="TextDim">#7F78A8</SolidColorBrush>
                    <SolidColorBrush x:Key="TextAccent">#C4B5FD</SolidColorBrush>
                    <SolidColorBrush x:Key="TextTitle">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="Icon">#9A8FC9</SolidColorBrush>
                    <SolidColorBrush x:Key="IconActive">#F3EFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="FolderIcon">#C084FC</SolidColorBrush>
                    <SolidColorBrush x:Key="Accent">#A855F7</SolidColorBrush>
                    <SolidColorBrush x:Key="Primary">#6D28D9</SolidColorBrush>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgMain">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="BgBar">#EEEAF8</SolidColorBrush>
                    <SolidColorBrush x:Key="BgSide">#F5F2FC</SolidColorBrush>
                    <SolidColorBrush x:Key="BgPanel">#F3F0FA</SolidColorBrush>
                    <SolidColorBrush x:Key="BgHover">#E6E0F5</SolidColorBrush>
                    <SolidColorBrush x:Key="BgFloat">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="Line">#D9D2EE</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMain">#1F1A3D</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMuted">#5E5683</SolidColorBrush>
                    <SolidColorBrush x:Key="TextDim">#7A7399</SolidColorBrush>
                    <SolidColorBrush x:Key="TextAccent">#6D28D9</SolidColorBrush>
                    <SolidColorBrush x:Key="TextTitle">#1F1A3D</SolidColorBrush>
                    <SolidColorBrush x:Key="Icon">#5B5185</SolidColorBrush>
                    <SolidColorBrush x:Key="IconActive">#1F1A3D</SolidColorBrush>
                    <SolidColorBrush x:Key="FolderIcon">#9333EA</SolidColorBrush>
                    <SolidColorBrush x:Key="Accent">#7C3AED</SolidColorBrush>
                    <SolidColorBrush x:Key="Primary">#7C3AED</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Gesture="Ctrl+J" Command="{Binding ToggleBottomCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+E"
                    Command="{Binding ShowPanelCommand}"
                    CommandParameter="0" />
        <KeyBinding Gesture="Ctrl+Shift+F"
                    Command="{Binding ShowPanelCommand}"
                    CommandParameter="1" />
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="Path.icon">
            <Setter Property="Stroke" Value="{DynamicResource Icon}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>

        <Style Selector="Path.active">
            <Setter Property="Stroke" Value="{DynamicResource IconActive}" />
        </Style>

        <Style Selector="Path.small">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>

        <Style Selector="Button.act">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.act:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>

        <Style Selector="Border.doctab">
            <Setter Property="Background" Value="{DynamicResource BgBar}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,2,0,0" />
        </Style>

        <Style Selector="Border.doctab.active">
            <Setter Property="Background" Value="{DynamicResource BgMain}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextAccent}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource BgMain}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource BgMain}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- Menus -->
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource BgMain}"
              FontSize="13">

            <MenuItem Header="_Fichier">
                <MenuItem Header="Nouveau fichier"
                          InputGesture="Ctrl+N"
                          Command="{Binding NewFileCommand}" />
                <MenuItem Header="Ouvrir un dossier..."
                          Click="OnOpenFolder" />
                <Separator />
                <MenuItem Header="Enregistrer"
                          InputGesture="Ctrl+S"
                          Click="OnSave"
                          IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Enregistrer sous..."
                          InputGesture="Ctrl+Shift+S"
                          Click="OnSaveAs"
                          IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Fermer le fichier"
                          Click="OnCloseActive"
                          IsEnabled="{Binding HasFile}" />
                <Separator />
                <MenuItem Header="Quitter" Click="OnExit" />
            </MenuItem>

            <MenuItem Header="_Édition">
                <MenuItem Header="Annuler"
                          InputGesture="Ctrl+Z"
                          Command="{Binding UndoCommand}"
                          IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Rétablir"
                          InputGesture="Ctrl+Y"
                          Command="{Binding RedoCommand}"
                          IsEnabled="{Binding HasFile}" />
                <Separator />
                <MenuItem Header="Couper" Click="OnCut"
                          IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Copier" Click="OnCopy"
                          IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Coller" Click="OnPaste"
                          IsEnabled="{Binding HasFile}" />
                <Separator />
                <MenuItem Header="Rechercher dans le fichier"
                          InputGesture="Ctrl+F"
                          Click="OnFind"
                          IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Remplacer"
                          Click="OnFind"
                          IsEnabled="{Binding HasFile}" />
            </MenuItem>

            <MenuItem Header="_Sélection">
                <MenuItem Header="Tout sélectionner"
                          Command="{Binding SelectAllTextCommand}"
                          IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Ajouter un curseur"
                          Command="{Binding NotAvailableCommand}"
                          CommandParameter="développeur 2|Ajouter un curseur" />
            </MenuItem>

            <MenuItem Header="_Affichage">
                <MenuItem Header="Palette de commandes..." IsEnabled="False" />
                <MenuItem Header="Paramètres..." Click="OnOpenSettings" />
                <Separator />
                <MenuItem Header="Explorateur"
                          Command="{Binding ShowPanelCommand}"
                          CommandParameter="0" />
                <MenuItem Header="Recherche"
                          Command="{Binding ShowPanelCommand}"
                          CommandParameter="1" />
                <MenuItem Header="Contrôle de code source"
                          Command="{Binding ShowPanelCommand}"
                          CommandParameter="2" />
                <MenuItem Header="Exécuter et déboguer"
                          Command="{Binding ShowPanelCommand}"
                          CommandParameter="3" />
                <MenuItem Header="Extensions"
                          Command="{Binding ShowPanelCommand}"
                          CommandParameter="4" />
                <Separator />
                <MenuItem Header="Problèmes"
                          Command="{Binding ShowBottomCommand}"
                          CommandParameter="0" />
                <MenuItem Header="Sortie"
                          Command="{Binding ShowBottomCommand}"
                          CommandParameter="1" />
                <MenuItem Header="Terminal"
                          Command="{Binding ShowBottomCommand}"
                          CommandParameter="2" />
                <MenuItem Header="Afficher / masquer le panneau du bas"
                          InputGesture="Ctrl+J"
                          Command="{Binding ToggleBottomCommand}" />
                <Separator />
                <MenuItem Header="Afficher / masquer la barre latérale"
                          InputGesture="Ctrl+B"
                          Command="{Binding ToggleSidebarCommand}" />
                <MenuItem Header="Thème clair / sombre"
                          Click="OnToggleTheme" />
            </MenuItem>

            <MenuItem Header="_Atteindre">
                <MenuItem Header="Aller au fichier..."
                          InputGesture="Ctrl+P"
                          Click="OnGoToFile" />
                <MenuItem Header="Aller à la ligne..."
                          InputGesture="Ctrl+G"
                          Click="OnGoToLine"
                          IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Aller à la définition"
                          Command="{Binding NotAvailableCommand}"
                          CommandParameter="développeur 3|Aller à la définition" />
            </MenuItem>

            <MenuItem Header="E_xécuter">
                <MenuItem Header="Démarrer le débogage"
                          Click="OnStartDebug" />
                <MenuItem Header="Exécuter sans débogage"
                          Command="{Binding NotAvailableCommand}"
                          CommandParameter="développeur 5|Exécuter sans débogage" />
                <MenuItem Header="Arrêter"
                          Command="{Binding StopDebugCommand}" />
            </MenuItem>

            <MenuItem Header="_Terminal">
                <MenuItem Header="Nouveau terminal"
                          Command="{Binding ShowBottomCommand}"
                          CommandParameter="2" />
                <MenuItem Header="Exécuter une tâche..."
                          Command="{Binding NotAvailableCommand}"
                          CommandParameter="développeur 5|Exécuter une tâche" />
            </MenuItem>

            <MenuItem Header="_Aide">
                <MenuItem Header="Documentation" Click="OnDocumentation" />
                <MenuItem Header="Raccourcis clavier" Click="OnShortcuts" />
                <Separator />
                <MenuItem Header="À propos de Keyce Code" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <!-- Barre d'état -->
        <Border DockPanel.Dock="Bottom"
                Height="24"
                Background="{DynamicResource Primary}">
            <Grid ColumnDefinitions="*,Auto" Margin="12,0">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="16"
                            VerticalAlignment="Center"
                            IsVisible="{Binding HasFile}">
                    <TextBlock Text="{Binding Position}" Foreground="White" FontSize="12" />
                    <TextBlock Text="{Binding Encoding}" Foreground="White" FontSize="12" />
                    <TextBlock Text="{Binding Language}" Foreground="White" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="RootGrid"
              ColumnDefinitions="52,260,4,*">

            <!-- Barre d'activité -->
            <Border Grid.Column="0" Background="{DynamicResource BgBar}">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Classes="act" Click="OnOpenSettings"
                            ToolTip.Tip="Paramètres">
                        <Path Classes="icon"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z M12 4.5a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15z M12 2v2.5 M12 19.5V22 M2 12h2.5 M19.5 12H22 M4.9 4.9l1.8 1.8 M17.3 17.3l1.8 1.8 M4.9 19.1l1.8-1.8 M17.3 6.7l1.8-1.8" />
                    </Button>

                    <StackPanel>
                        <Grid Height="48">
                            <Border Width="2"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Accent}"
                                    IsVisible="{Binding IsExplorerActive}" />
                            <Button Classes="act"
                                    Command="{Binding ShowPanelCommand}"
                                    CommandParameter="0">
                                <Path Classes="icon"
                                      Classes.active="{Binding IsExplorerActive}"
                                      Data="M5 7h9l4 4v10H5z M14 7v4h4 M8 7V3h8l4 4v10h-2" />
                            </Button>
                        </Grid>

                        <Grid Height="48">
                            <Border Width="2"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Accent}"
                                    IsVisible="{Binding IsSearchActive}" />
                            <Button Classes="act"
                                    Command="{Binding ShowPanelCommand}"
                                    CommandParameter="1">
                                <Path Classes="icon"
                                      Classes.active="{Binding IsSearchActive}"
                                      Data="M14 4a6 6 0 1 0 0 12 6 6 0 0 0 0-12z M9.8 14.2L4 20" />
                            </Button>
                        </Grid>

                        <Grid Height="48">
                            <Border Width="2"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Accent}"
                                    IsVisible="{Binding IsGitActive}" />
                            <Button Classes="act"
                                    Command="{Binding ShowPanelCommand}"
                                    CommandParameter="2">
                                <Path Classes="icon"
                                      Classes.active="{Binding IsGitActive}"
                                      Data="M6 2.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z M6 16.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z M18 6.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z M6 7.5v9 M18 11.5c0 3.5-12 1.5-12 5" />
                            </Button>
                        </Grid>

                        <Grid Height="48">
                            <Border Width="2"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Accent}"
                                    IsVisible="{Binding IsRunActive}" />
                            <Button Classes="act"
                                    Command="{Binding ShowPanelCommand}"
                                    CommandParameter="3">
                                <Path Classes="icon"
                                      Classes.active="{Binding IsRunActive}"
                                      Data="M5 3.5l10 6.5-10 6.5z M15.5 17.5a2.5 3.5 0 1 0 5 0 2.5 3.5 0 0 0-5 0z M14 16h1.5 M20.5 16H22 M14 20h1.5 M20.5 20H22 M18 14v7" />
                            </Button>
                        </Grid>

                        <Grid Height="48">
                            <Border Width="2"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Accent}"
                                    IsVisible="{Binding IsExtensionsActive}" />
                            <Button Classes="act"
                                    Command="{Binding ShowPanelCommand}"
                                    CommandParameter="4">
                                <Path Classes="icon"
                                      Classes.active="{Binding IsExtensionsActive}"
                                      Data="M3 13h7v7H3z M12 13h7v7h-7z M3 4h7v7H3z M15 2h6v6h-6z" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Barre latérale -->
            <Border Grid.Column="1"
                    Background="{DynamicResource BgSide}"
                    ClipToBounds="True"
                    IsVisible="{Binding IsSidebarVisible}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding PanelTitle}"
                               FontSize="11"
                               Foreground="{DynamicResource TextAccent}"
                               Margin="16,12,0,4" />

                    <Grid>

                        <!-- Explorateur -->
                        <DockPanel IsVisible="{Binding IsExplorerActive}">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{Binding FolderName}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMain}"
                                       Margin="16,4,0,6"
                                       IsVisible="{Binding HasFolder}" />

                            <StackPanel DockPanel.Dock="Top"
                                        Margin="16,16"
                                        Spacing="10"
                                        IsVisible="{Binding !HasFolder}">
                                <TextBlock Text="Aucun dossier ouvert"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="12" />
                                <Button Content="Ouvrir un dossier"
                                        Click="OnOpenFolder"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Background="{DynamicResource Primary}"
                                        Foreground="White" />
                            </StackPanel>

                            <TreeView ItemsSource="{Binding Nodes}"
                                      Background="Transparent"
                                      Margin="4,0"
                                      SelectionChanged="OnNodeSelected"
                                      IsVisible="{Binding HasFolder}">
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate DataType="vm:FileNode"
                                                      ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="icon small"
                                                  IsVisible="{Binding IsDirectory}"
                                                  Stroke="{DynamicResource FolderIcon}"
                                                  Data="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                            <Path Classes="icon small"
                                                  IsVisible="{Binding !IsDirectory}"
                                                  Data="M6 2h8l4 4v16H6z M14 2v4h4" />
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource TextMain}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>

                        <!-- Recherche de fichiers -->
                        <DockPanel IsVisible="{Binding IsSearchActive}">
                            <TextBox DockPanel.Dock="Top"
                                     x:Name="SearchBox"
                                     Text="{Binding SearchQuery}"
                                     PlaceholderText="Nom de fichier..."
                                     Margin="12,6"
                                     Background="{DynamicResource BgMain}"
                                     Foreground="{DynamicResource TextMain}" />

                            <TextBlock DockPanel.Dock="Top"
                                       Text="{Binding SearchInfo}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="12"
                                       Margin="16,0,0,6" />

                            <ListBox ItemsSource="{Binding SearchResults}"
                                     Background="Transparent"
                                     SelectionChanged="OnNodeSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:FileNode">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource TextMain}"
                                                       FontSize="13" />
                                            <TextBlock Text="{Binding Directory}"
                                                       Foreground="{DynamicResource TextDim}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- Git -->
                        <DockPanel IsVisible="{Binding IsGitActive}">
                            <StackPanel DockPanel.Dock="Top"
                                        Margin="12,6,12,8"
                                        Spacing="10">

                                <Border Background="{DynamicResource BgHover}"
                                        CornerRadius="6"
                                        Padding="10,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Branche"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextDim}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Git.Controller.CurrentBranch}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextAccent}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource BgHover}"
                                        CornerRadius="6"
                                        Padding="12"
                                        IsVisible="{Binding IsGitRepoMissing}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding GitMessage}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextMain}" />
                                        <Button Content="Initialiser un dépôt Git"
                                                Command="{Binding InitGitCommand}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Padding="10,8"
                                                Background="{DynamicResource Primary}"
                                                Foreground="White" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding GitMessage}"
                                           Foreground="#F87171"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasGitError}" />

                                <StackPanel Spacing="8"
                                            IsVisible="{Binding !IsGitRepoMissing}">
                                    <TextBox Text="{Binding Git.Controller.CommitMessage}"
                                             PlaceholderText="Message de commit"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Height="70"
                                             Background="{DynamicResource BgMain}"
                                             Foreground="{DynamicResource TextMain}" />

                                    <Button Content="Valider (commit)"
                                            Command="{Binding Git.CommitCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="10,8"
                                            Background="{DynamicResource Primary}"
                                            Foreground="White" />

                                    <UniformGrid Columns="2">
                                        <Button Content="Tout indexer"
                                                Command="{Binding Git.StageAllCommand}"
                                                Margin="0,0,3,6"
                                                Padding="6,7" />
                                        <Button Content="Actualiser"
                                                Command="{Binding Git.RefreshCommand}"
                                                Margin="3,0,0,6"
                                                Padding="6,7" />
                                        <Button Content="Pull"
                                                Command="{Binding Git.PullCommand}"
                                                Margin="0,0,3,0"
                                                Padding="6,7" />
                                        <Button Content="Push"
                                                Command="{Binding Git.PushCommand}"
                                                Margin="3,0,0,0"
                                                Padding="6,7" />
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>

                            <ScrollViewer IsVisible="{Binding !IsGitRepoMissing}">
                                <StackPanel Margin="12,0,8,8" Spacing="2">
                                    <TextBlock Text="CHANGEMENTS INDEXÉS"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextAccent}"
                                               Margin="0,6,0,2" />

                                    <ItemsControl ItemsSource="{Binding Git.Controller.StagedFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="core:GitFileStatus">
                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                      Margin="0,2">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding State}"
                                                               FontSize="10"
                                                               Width="70"
                                                               Foreground="{DynamicResource TextDim}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Path}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextMain}"
                                                               VerticalAlignment="Center"
                                                               Cursor="Hand"
                                                               PointerPressed="OnGitFilePressed" />
                                                    <Button Grid.Column="2"
                                                            Content="Retirer"
                                                            Click="OnGitUnstageClick"
                                                            Background="Transparent"
                                                            Foreground="{DynamicResource TextAccent}"
                                                            Padding="8,2"
                                                            FontSize="11" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="CHANGEMENTS"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextAccent}"
                                               Margin="0,10,0,2" />

                                    <ItemsControl ItemsSource="{Binding Git.Controller.UnstagedFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="core:GitFileStatus">
                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                      Margin="0,2">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding State}"
                                                               FontSize="10"
                                                               Width="70"
                                                               Foreground="{DynamicResource TextDim}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Path}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextMain}"
                                                               VerticalAlignment="Center"
                                                               Cursor="Hand"
                                                               PointerPressed="OnGitFilePressed" />
                                                    <Button Grid.Column="2"
                                                            Content="Indexer"
                                                            Click="OnGitStageClick"
                                                            Background="Transparent"
                                                            Foreground="{DynamicResource TextAccent}"
                                                            Padding="8,2"
                                                            FontSize="11" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Exécuter et déboguer -->
                        <ScrollViewer IsVisible="{Binding IsRunActive}">
                            <StackPanel Margin="12,4,12,12" Spacing="10">
                                <TextBlock Text="Programme .NET compilé (.dll)"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding DebugProgram}"
                                             PlaceholderText="bin\Debug\net10.0\MonApp.dll"
                                             Background="{DynamicResource BgMain}"
                                             Foreground="{DynamicResource TextMain}" />
                                    <Button Grid.Column="1"
                                            Content="Parcourir"
                                            Click="OnBrowseProgram"
                                            Margin="6,0,0,0" />
                                </Grid>

                                <UniformGrid Columns="2">
                                    <Button Content="Démarrer"
                                            Command="{Binding StartDebugCommand}"
                                            IsEnabled="{Binding IsDebugIdle}"
                                            Margin="0,0,3,6"
                                            Padding="6,7"
                                            Background="{DynamicResource Primary}"
                                            Foreground="White" />
                                    <Button Content="Arrêter"
                                            Command="{Binding StopDebugCommand}"
                                            IsEnabled="{Binding IsDebugging}"
                                            Margin="3,0,0,6"
                                            Padding="6,7" />
                                    <Button Content="Continuer"
                                            Command="{Binding DebugContinueCommand}"
                                            IsEnabled="{Binding IsDebugging}"
                                            Margin="0,0,3,6"
                                            Padding="6,7" />
                                    <Button Content="Pas à pas"
                                            Command="{Binding DebugOverCommand}"
                                            IsEnabled="{Binding IsDebugging}"
                                            Margin="3,0,0,6"
                                            Padding="6,7" />
                                    <Button Content="Entrer"
                                            Command="{Binding DebugIntoCommand}"
                                            IsEnabled="{Binding IsDebugging}"
                                            Margin="0,0,3,0"
                                            Padding="6,7" />
                                    <Button Content="Sortir"
                                            Command="{Binding DebugOutCommand}"
                                            IsEnabled="{Binding IsDebugging}"
                                            Margin="3,0,0,0"
                                            Padding="6,7" />
                                </UniformGrid>

                                <Border Background="{DynamicResource BgHover}"
                                        CornerRadius="6"
                                        Padding="10,8">
                                    <TextBlock Text="{Binding DebugStatus}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMain}" />
                                </Border>

                                <TextBlock Text="POINTS D'ARRÊT"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextAccent}"
                                           Margin="0,6,0,0" />

                                <Button Content="Ajouter à la ligne du curseur"
                                        Click="OnAddBreakpoint"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="6,7" />

                                <ItemsControl ItemsSource="{Binding Breakpoints}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextMain}"
                                                       Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="Vider la liste"
                                        Command="{Binding ClearBreakpointsCommand}"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextAccent}"
                                        HorizontalAlignment="Left"
                                        FontSize="11" />

                                <TextBlock TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextDim}"
                                           Text="Prérequis : NetCoreDbg installé (par exemple « scoop install netcoredbg ») et un projet déjà compilé." />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Extensions -->
                        <DockPanel IsVisible="{Binding IsExtensionsActive}">
                            <StackPanel DockPanel.Dock="Top"
                                        Margin="12,4,12,8"
                                        Spacing="8">
                                <Button Content="Installer depuis un dossier..."
                                        Click="OnInstallExtension"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="6,7"
                                        Background="{DynamicResource Primary}"
                                        Foreground="White" />
                                <TextBlock Text="{Binding ExtensionsInfo}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" />
                            </StackPanel>

                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding ExtensionItems}"
                                              Margin="12,0,12,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ExtensionItem">
                                            <Border Background="{DynamicResource BgHover}"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    Margin="0,0,0,8">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextMain}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding StateText}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextAccent}" />
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                    <TextBlock Text="{Binding Permissions}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextDim}" />
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="6"
                                                                Margin="0,4,0,0">
                                                        <Button Content="{Binding ToggleLabel}"
                                                                Click="OnExtensionToggle"
                                                                Padding="10,4" />
                                                        <Button Content="Désinstaller"
                                                                Click="OnExtensionUninstall"
                                                                Padding="10,4" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Panneaux non encore disponibles -->
                        <StackPanel IsVisible="{Binding IsPlaceholderActive}"
                                    Margin="16,12">
                            <TextBlock Text="{Binding PlaceholderMessage}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="2"
                          Background="{DynamicResource BgMain}"
                          ResizeDirection="Columns"
                          IsVisible="{Binding IsSidebarVisible}" />

            <!-- Zone centrale -->
            <Grid Grid.Column="3"
                  x:Name="CenterGrid"
                  RowDefinitions="36,*,0,0">

                <!-- Onglets des documents -->
                <Border Grid.Row="0" Background="{DynamicResource BgBar}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource BgMain}"
                                BorderBrush="{DynamicResource Accent}"
                                BorderThickness="0,2,0,0"
                                Padding="16,0"
                                IsVisible="{Binding !HasFile}">
                            <TextBlock Text="Bienvenue"
                                       Foreground="{DynamicResource TextMain}"
                                       VerticalAlignment="Center"
                                       FontSize="13" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:DocumentTab">
                                    <Border Classes="doctab"
                                            Classes.active="{Binding IsActive}"
                                            Padding="14,0,4,0"
                                            Cursor="Hand"
                                            PointerPressed="OnTabPressed">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource TextMain}"
                                                       VerticalAlignment="Center"
                                                       FontSize="13" />
                                            <TextBlock Text="●"
                                                       Foreground="{DynamicResource Accent}"
                                                       FontSize="9"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding IsDirty}" />
                                            <Button Content="✕"
                                                    Click="OnTabCloseClick"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource TextAccent}"
                                                    Padding="6,2" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Accueil -->
                <Border Grid.Row="1"
                        Background="{DynamicResource BgMain}"
                        IsVisible="{Binding !HasFile}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="10">
                        <Image Source="avares://App.Desktop/Assets/logo.png"
                               Width="150"
                               Height="150" />

                        <TextBlock FontSize="46"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center">
                            <Run Text="Keyce "
                                 Foreground="{DynamicResource TextTitle}" />
                            <Run Text="Code" Foreground="#C026D3" />
                        </TextBlock>

                        <TextBlock Text="Créez. Codez. Innovez."
                                   FontSize="18"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextAccent}"
                                   HorizontalAlignment="Center" />

                        <Button Content="Ouvrir un dossier..."
                                Click="OnOpenFolder"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0"
                                Padding="20,8"
                                Background="{DynamicResource Primary}"
                                Foreground="White" />
                    </StackPanel>
                </Border>

                <!-- Éditeur -->
                <TextBox Grid.Row="1"
                         x:Name="EditorBox"
                         Text="{Binding FileContent, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas,Cascadia Mono,monospace"
                         FontSize="14"
                         Background="{DynamicResource BgMain}"
                         Foreground="{DynamicResource TextMain}"
                         BorderThickness="0"
                         CornerRadius="0"
                         Padding="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         IsVisible="{Binding HasFile}" />

                <!-- Recherche et remplacement -->
                <Border Grid.Row="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,24,0"
                        Padding="8"
                        Background="{DynamicResource BgFloat}"
                        BorderBrush="{DynamicResource Line}"
                        BorderThickness="1"
                        CornerRadius="6"
                        IsVisible="{Binding IsFindVisible}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox x:Name="FindBox"
                                     Width="200"
                                     PlaceholderText="Rechercher..."
                                     Text="{Binding FindText}"
                                     Background="{DynamicResource BgMain}"
                                     Foreground="{DynamicResource TextMain}"
                                     KeyDown="OnFindKeyDown" />

                            <ToggleButton Content="Aa"
                                          IsChecked="{Binding MatchCase}"
                                          ToolTip.Tip="Respecter la casse" />

                            <ToggleButton Content=".*"
                                          IsChecked="{Binding UseRegex}"
                                          ToolTip.Tip="Expression régulière" />

                            <TextBlock Text="{Binding FindInfo}"
                                       Foreground="{DynamicResource TextAccent}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       MinWidth="80" />

                            <Button Content="↑"
                                    Click="OnFindPrevClick"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextAccent}" />

                            <Button Content="↓"
                                    Click="OnFindNextClick"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextAccent}" />

                            <Button Content="✕"
                                    Click="OnFindClose"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextAccent}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox Width="200"
                                     PlaceholderText="Remplacer par..."
                                     Text="{Binding ReplaceText}"
                                     Background="{DynamicResource BgMain}"
                                     Foreground="{DynamicResource TextMain}"
                                     KeyDown="OnReplaceKeyDown" />

                            <Button Content="Remplacer"
                                    Click="OnReplaceClick"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextAccent}" />

                            <Button Content="Tout remplacer"
                                    Click="OnReplaceAllClick"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextAccent}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <GridSplitter Grid.Row="2"
                              ResizeDirection="Rows"
                              Background="{DynamicResource BgMain}"
                              HorizontalAlignment="Stretch"
                              IsVisible="{Binding IsBottomVisible}" />

                <!-- Panneau inférieur -->
                <Border Grid.Row="3"
                        Background="{DynamicResource BgPanel}"
                        BorderBrush="{DynamicResource Line}"
                        BorderThickness="0,1,0,0"
                        IsVisible="{Binding IsBottomVisible}">
                    <DockPanel>

                        <Grid DockPanel.Dock="Top"
                              Height="32"
                              ColumnDefinitions="Auto,Auto,Auto,*,Auto">

                            <Grid Grid.Column="0">
                                <Border Height="2"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource Accent}"
                                        IsVisible="{Binding IsProblemsTab}" />
                                <Button Classes="tab"
                                        Content="PROBLÈMES"
                                        Command="{Binding SetBottomTabCommand}"
                                        CommandParameter="0" />
                            </Grid>

                            <Grid Grid.Column="1">
                                <Border Height="2"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource Accent}"
                                        IsVisible="{Binding IsOutputTab}" />
                                <Button Classes="tab"
                                        Content="SORTIE"
                                        Command="{Binding SetBottomTabCommand}"
                                        CommandParameter="1" />
                            </Grid>

                            <Grid Grid.Column="2">
                                <Border Height="2"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource Accent}"
                                        IsVisible="{Binding IsTerminalTab}" />
                                <Button Classes="tab"
                                        Content="TERMINAL"
                                        Command="{Binding SetBottomTabCommand}"
                                        CommandParameter="2" />
                            </Grid>

                            <Button Grid.Column="4"
                                    Content="✕"
                                    Command="{Binding ToggleBottomCommand}"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextAccent}"
                                    Margin="0,0,8,0" />
                        </Grid>

                        <Grid>

                            <!-- Problèmes -->
                            <DockPanel IsVisible="{Binding IsProblemsTab}">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="{Binding ProblemsSummary}"
                                           Margin="16,8,16,4"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="12" />

                                <ListBox ItemsSource="{Binding Problems}"
                                         Background="Transparent"
                                         SelectionChanged="OnProblemSelected">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="vm:ProblemItem">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Severity}"
                                                           FontSize="11"
                                                           Width="90"
                                                           Foreground="{DynamicResource TextAccent}" />
                                                <TextBlock Text="{Binding Message}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextMain}" />
                                                <TextBlock Text="{Binding Location}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextDim}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- Sortie -->
                            <TextBox IsVisible="{Binding IsOutputTab}"
                                     Text="{Binding OutputText}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     Background="{DynamicResource BgPanel}"
                                     Foreground="{DynamicResource TextMain}"
                                     BorderThickness="0"
                                     FontFamily="Consolas,Cascadia Mono,monospace"
                                     FontSize="12"
                                     Padding="12,8" />

                            <!-- Terminal PTY avec émulateur XTerm -->
                            <Grid IsVisible="{Binding IsTerminalTab}"
                                  RowDefinitions="Auto,*"
                                  Margin="12"
                                  RowSpacing="8">

                                <Grid Grid.Row="0"
                                      ColumnDefinitions="Auto,Auto,*,Auto">

                                    <Button Grid.Column="0"
                                            Content="Démarrer"
                                            Command="{Binding StartTerminalCommand}"
                                            IsEnabled="{Binding !IsTerminalRunning}"
                                            Background="{DynamicResource Primary}"
                                            Foreground="White"
                                            Padding="12,6"
                                            Margin="0,0,8,0" />

                                    <Button Grid.Column="1"
                                            Content="Arrêter"
                                            Command="{Binding StopTerminalCommand}"
                                            IsEnabled="{Binding IsTerminalRunning}"
                                            Background="{DynamicResource BgHover}"
                                            Foreground="{DynamicResource TextMain}"
                                            Padding="12,6" />

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding TerminalStatus}"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <terminal:TerminalControl x:Name="TerminalView"
                                                          Grid.Row="1" />
                            </Grid>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>