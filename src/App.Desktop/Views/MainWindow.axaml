<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="App.Desktop.Views.MainWindow"
        Title="Keyce Code"
        Width="1200"
        Height="750"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

	<DockPanel>

		<Menu DockPanel.Dock="Top" Background="#333333">
			<MenuItem Header="_Fichier">
				<MenuItem Header="Nouveau fichier"/>
				<MenuItem Header="Ouvrir un fichier"/>
				<MenuItem Header="Ouvrir un dossier"
                          Click="OpenFolder_Click"/>
				<Separator/>
				<MenuItem Header="Enregistrer"/>
			</MenuItem>
			<MenuItem Header="_Édition"/>
			<MenuItem Header="_Sélection"/>
			<MenuItem Header="_Affichage"/>
			<MenuItem Header="_Aide"/>
		</Menu>

		<Border DockPanel.Dock="Bottom"
                Height="25"
                Background="#007ACC">
			<Grid ColumnDefinitions="*,Auto">
				<TextBlock Text="Prêt"
                           Foreground="White"
                           Margin="10,0"
                           VerticalAlignment="Center"/>
				<TextBlock Grid.Column="1"
                           Text="C# | UTF-8"
                           Foreground="White"
                           Margin="10,0"
                           VerticalAlignment="Center"/>
			</Grid>
		</Border>

		<Grid ColumnDefinitions="50,230,4,*">

			<Border Grid.Column="0" Background="#252526">
				<StackPanel Spacing="25" Margin="0,15">
					<TextBlock Text="📁" FontSize="23"
                               HorizontalAlignment="Center"/>
					<TextBlock Text="🔍" FontSize="23"
                               HorizontalAlignment="Center"/>
					<TextBlock Text="⚙" FontSize="23"
                               HorizontalAlignment="Center"/>
				</StackPanel>
			</Border>

			<Border Grid.Column="1" Background="#252526">
				<StackPanel Margin="12">
					<TextBlock Text="EXPLORATEUR"
                               Foreground="#BBBBBB"
                               FontSize="12"
                               FontWeight="Bold"
                               Margin="0,5,0,20"/>

					<TextBlock x:Name="FolderName"
                               Text="KEYCE CODE"
                               Foreground="White"
                               FontWeight="Bold"/>

					<ListBox x:Name="ExplorerList"
                             Background="#252526"
                             Foreground="White"
                             BorderThickness="0"
                             Margin="0,10,0,0"
                             SelectionChanged="ExplorerList_SelectionChanged"/>
				</StackPanel>
			</Border>

			<GridSplitter Grid.Column="2"
                          Background="#444444"
                          ResizeDirection="Columns"/>

			<Grid Grid.Column="3"
                  Background="#1E1E1E"
                  RowDefinitions="35,*">

				<Border Background="#252526">
					<TextBlock x:Name="EditorTitle"
                               Text="Bienvenue dans Keyce Code"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="15,0"/>
				</Border>

				<TextBox x:Name="EditorTextBox"
                         Grid.Row="1"
                         Background="#1E1E1E"
                         Foreground="#D4D4D4"
                         FontFamily="Consolas"
                         FontSize="14"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"
                         Padding="15"/>

			</Grid>
		</Grid>
	</DockPanel>
</Window>