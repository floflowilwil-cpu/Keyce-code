<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:App.Desktop.ViewModels"
             x:Class="App.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Padding="24,14,24,10">
		<TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Rechercher dans les paramètres" MaxWidth="900"/>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="250,*">
      <ListBox Grid.Column="0" ItemsSource="{Binding Categories}"
               SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" Margin="12,0,0,0" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" Padding="4,2"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ScrollViewer Grid.Column="1">
        <StackPanel Margin="32,4,32,32" MaxWidth="900" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,14">
            <TextBlock Text="Utilisateur" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Text="{Binding ResultText}" Opacity="0.6" VerticalAlignment="Center"/>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingItemViewModel">
                <StackPanel Spacing="4" Margin="0,0,0,26">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="14"/>
                    <Button Grid.Column="1" Content="Réinitialiser" Padding="8,2" FontSize="11"
                            Command="{Binding ResetCommand}" IsVisible="{Binding IsModified}"/>
                  </Grid>
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.7"/>

                  <ContentControl Content="{Binding}" Margin="0,6,0,0" HorizontalAlignment="Left">
                    <ContentControl.DataTemplates>
                      <DataTemplate x:DataType="vm:BoolSettingViewModel">
                        <CheckBox IsChecked="{Binding Value, Mode=TwoWay}" Content="Activé"/>
                      </DataTemplate>
                      <DataTemplate x:DataType="vm:TextSettingViewModel">
                        <TextBox Text="{Binding Value, Mode=TwoWay}" Width="420"/>
                      </DataTemplate>
                      <DataTemplate x:DataType="vm:ChoiceSettingViewModel">
                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value, Mode=TwoWay}" MinWidth="240"/>
                      </DataTemplate>
                      <DataTemplate x:DataType="vm:NumberSettingViewModel">
                        <NumericUpDown Value="{Binding Value, Mode=TwoWay}" Minimum="{Binding Minimum}"
                                       Maximum="{Binding Maximum}" Increment="1" FormatString="0" Width="160"/>
                      </DataTemplate>
                    </ContentControl.DataTemplates>
                  </ContentControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
